rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // VITRAG Tableware & Gifting — Production Firestore Security Rules
    // Project: vitrag-672ed
    // Architecture: Passcode-gated Merchant Console + Public Luxury Storefront
    // ===============================================================

    // 1. PRODUCTS COLLECTION
    // Luxury crockery, dinner sets, barware, and homeware catalog.
    // Storefront visitors read catalog; Merchant Console seeds/updates/deletes products.
    match /products/{productId} {
      allow read, write: if true;
    }

    // 2. ORDERS COLLECTION
    // Customer orders placed via checkout or recorded via Admin Order Management.
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // 3. ABANDONED CARTS COLLECTION
    // Real-time visitor checkout recovery and cart tracking.
    match /abandoned_carts/{cartId} {
      allow read, write: if true;
    }

    // 4. BULK INQUIRIES COLLECTION
    // Corporate gifting and wedding trousseau lead submissions.
    match /bulk_inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // 5. STORE SETTINGS COLLECTION
    // Site-wide announcements, delivery fee thresholds, contact phone & UPI ID.
    match /store_settings/{settingsDoc} {
      allow read, write: if true;
    }
  }
}
