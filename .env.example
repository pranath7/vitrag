# ==============================================================================
# VITRAG Tableware & Gifting — Production Environment Configuration
# ==============================================================================
# Copy this file to `.env.local` for local development.
# In Vercel, copy these key-value pairs into Project Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CLOUD FIRESTORE CONFIGURATION
# ------------------------------------------------------------------------------
# Get these credentials from your Firebase Console:
# 1. Go to https://console.firebase.google.com/
# 2. Select your project > Project Settings (gear icon) > General.
# 3. Under "Your apps", select the Web App (</>) and copy the firebaseConfig values.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890abcdef"

# ------------------------------------------------------------------------------
# 2. CLOUDINARY MEDIA CDN & IMAGE STORAGE
# ------------------------------------------------------------------------------
# Used for storing and serving high-resolution tableware photos via Cloudinary CDN.
# 1. Sign up / Log in at https://cloudinary.com/
# 2. Go to Dashboard to find your "Cloud Name".
# 3. Go to Settings (gear icon) > Upload tab > "Upload presets".
# 4. Click "Add upload preset", set Signing Mode to "Unsigned", and name it e.g. "vitrag_unsigned".
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="vitrag_unsigned"

# ------------------------------------------------------------------------------
# 3. STORE IDENTITY & CONTACTS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://vitrag.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="916369142027"
NEXT_PUBLIC_UPI_ID="9840610405@pthdfc"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/vitragtableware"

# Analytics (Optional)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# ------------------------------------------------------------------------------
# 4. SERVER-SIDE ADMIN AUTHENTICATION (Never expose in NEXT_PUBLIC_ variables)
# ------------------------------------------------------------------------------
ADMIN_PASSCODE="set-a-strong-secret-passcode-here"
ADMIN_SESSION_SECRET="generate-a-random-32-byte-hex-string-for-session-signing"
